# ============================================================
# StudioSpace Server - Environment Variables
# Copy to `.env` and fill in real values. NEVER commit .env.
# ============================================================

# Port the Express API listens on
PORT=5001
# development | production
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or a local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name shared with the client's Better Auth adapter
DB_NAME=studiospace

# Long random secret used to sign/verify application JWTs (HTTPOnly cookie).
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# JWT lifetime (jsonwebtoken style), e.g. 7d, 12h
JWT_EXPIRES_IN=7d
# Name of the HTTPOnly cookie carrying the JWT
JWT_COOKIE_NAME=studiospace_session

# Shared server-to-server secret. The Next.js server presents this when it
# exchanges a *verified Better Auth session* for an application JWT
# (POST /api/auth/token). Must match INTERNAL_API_SECRET on the client.
INTERNAL_API_SECRET=replace-with-another-long-random-secret

# Exact frontend origin allowed to send credentialed CORS requests.
# Never use a wildcard origin together with credentials.
CLIENT_URL=http://localhost:3000

# Optional: server-side imgbb API key used by POST /api/upload.
# Get a key at https://api.imgbb.com/  (leave empty to disable server upload)
IMGBB_API_KEY=
